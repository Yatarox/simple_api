# ==========================================
# CONFIGURATION BASE DE DONNÉES (MySQL)
# ==========================================
MYSQL_DATABASE=changeme-this-database-name
MYSQL_USER=changeme-this-user
MYSQL_PASSWORD=changeme-this-password
MYSQL_ROOT_PASSWORD=changeme-this-root-password

# Utilisé par l'API (SQLAlchemy)
# Format : mysql+pymysql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=mysql+pymysql://changeme-this-user:changeme-this-password@db:3306/changeme-this-database-name
# ==========================================
# CONFIGURATION API (FastAPI / JWT)
# ==========================================
SECRET_KEY=changeme-this-secret-key
ALGORITHM=changeme-this-algorithm
ACCESS_TOKEN_EXPIRE_MINUTES=60